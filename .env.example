# Centralized OpenRouter LLM Gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat,openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=15

# Legacy Gemini configuration (optional fallback)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tavily Web Search
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=8
TAVILY_PAGE_FETCH_LIMIT=4
TAVILY_TIMEOUT_SECONDS=8

# Serper Google Shopping
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/shopping
SERPER_GL=in
SERPER_HL=en
SERPER_NUM=10
SERPER_TIMEOUT_SECONDS=8

# Embedding & Reranker Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
